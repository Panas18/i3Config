#!/usr/bin/env python3
"""Enable libinput tap-to-click through the installed XInput library."""

import ctypes as C


class Device(C.Structure):
    _fields_ = [
        ("deviceid", C.c_int),
        ("name", C.c_char_p),
        ("use", C.c_int),
        ("attachment", C.c_int),
        ("enabled", C.c_int),
        ("num_classes", C.c_int),
        ("classes", C.c_void_p),
    ]


x = C.CDLL("libX11.so.6")
xi = C.CDLL("libXi.so.6")
x.XOpenDisplay.argtypes = [C.c_char_p]
x.XOpenDisplay.restype = C.c_void_p
x.XInternAtom.argtypes = [C.c_void_p, C.c_char_p, C.c_int]
x.XInternAtom.restype = C.c_ulong
x.XFree.argtypes = [C.c_void_p]
x.XSync.argtypes = [C.c_void_p, C.c_int]
x.XCloseDisplay.argtypes = [C.c_void_p]
xi.XIQueryDevice.argtypes = [C.c_void_p, C.c_int, C.POINTER(C.c_int)]
xi.XIQueryDevice.restype = C.POINTER(Device)
xi.XIFreeDeviceInfo.argtypes = [C.POINTER(Device)]
xi.XIGetProperty.argtypes = [
    C.c_void_p,
    C.c_int,
    C.c_ulong,
    C.c_long,
    C.c_long,
    C.c_int,
    C.c_ulong,
    C.POINTER(C.c_ulong),
    C.POINTER(C.c_int),
    C.POINTER(C.c_ulong),
    C.POINTER(C.c_ulong),
    C.POINTER(C.POINTER(C.c_ubyte)),
]
xi.XIChangeProperty.argtypes = [
    C.c_void_p,
    C.c_int,
    C.c_ulong,
    C.c_ulong,
    C.c_int,
    C.c_int,
    C.POINTER(C.c_ubyte),
    C.c_int,
]
display = x.XOpenDisplay(None)
if not display:
    raise SystemExit("No X11 display available")
atom = x.XInternAtom(display, b"libinput Tapping Enabled", 1)
count = C.c_int()
devices = xi.XIQueryDevice(display, 0, C.byref(count))
found = 0
try:
    for i in range(count.value):
        device = devices[i]
        if not atom or not device.enabled:
            continue
        kind, length, remaining = C.c_ulong(), C.c_ulong(), C.c_ulong()
        fmt = C.c_int()
        data = C.POINTER(C.c_ubyte)()
        status = xi.XIGetProperty(
            display,
            device.deviceid,
            atom,
            0,
            1,
            0,
            0,
            C.byref(kind),
            C.byref(fmt),
            C.byref(length),
            C.byref(remaining),
            C.byref(data),
        )
        if status == 0 and kind.value and fmt.value == 8 and length.value == 1:
            value = (C.c_ubyte * 1)(1)
            xi.XIChangeProperty(
                display, device.deviceid, atom, kind.value, 8, 0, value, 1
            )
            x.XSync(display, 0)
            x.XFree(data)
            data = C.POINTER(C.c_ubyte)()
            xi.XIGetProperty(
                display,
                device.deviceid,
                atom,
                0,
                1,
                0,
                0,
                C.byref(kind),
                C.byref(fmt),
                C.byref(length),
                C.byref(remaining),
                C.byref(data),
            )
            if not length.value or data[0] != 1:
                raise RuntimeError("Tap-to-click verification failed")
            print("Tap-to-click enabled and verified:", device.name.decode())
            found += 1
        if data:
            x.XFree(data)
finally:
    xi.XIFreeDeviceInfo(devices)
    x.XCloseDisplay(display)
if not found:
    raise SystemExit("No enabled libinput touchpad found")
