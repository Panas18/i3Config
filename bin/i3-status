#!/usr/bin/env python3
"""Hardware-independent i3blocks with bounded subprocesses and click actions."""
import datetime
import glob
import json
import os
import re
import subprocess
import time
from pathlib import Path


def run(*args):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=3)
        return p.stdout.strip() if p.returncode == 0 else ''
    except (OSError, subprocess.TimeoutExpired):
        return ''

def launch(*args):
    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)

def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ''

def meter(percent):
    filled = max(0, min(4, round(percent/25)))
    return '▰'*filled + '▱'*(4-filled)

name = os.environ.get('BLOCK_NAME', '')
click = os.environ.get('BLOCK_BUTTON', '')
if click == '1':
    apps = {'time': ['zenity', '--calendar', '--title=Calendar', '--text=Select a date', '--ok-label=Close'], 'network': ['nm-connection-editor'], 'bandwidth': ['nm-connection-editor'], 'bluetooth': ['blueman-manager'],
            'volume': ['pavucontrol', '--tab=3'], 'brightness': ['kitty', 'brightnessctl', '-l']}
    if name in apps:
        launch(*apps[name])
if name == 'volume' and click in ('3', '4', '5'):
    run(str(Path.home()/'.local/bin/i3-control'), {'3':'mute','4':'volume-up','5':'volume-down'}[click])
if name == 'brightness' and click in ('4', '5'):
    run(str(Path.home()/'.local/bin/i3-control'), 'brightness-up' if click == '4' else 'brightness-down')
if name == 'time':
    print(datetime.datetime.now().strftime('🕒 %a %d %b %Y %H:%M:%S'))
elif name == 'network':
    lines = run('nmcli', '-t', '--escape', 'no', '-f', 'TYPE,STATE,CONNECTION', 'device').splitlines()
    active = [line.split(':', 2) for line in lines if ':connected:' in line and not line.startswith('loopback:')]
    active.sort(key=lambda device: device[0] != 'wifi')
    if active:
        kind, _, connection = active[0]
        print(('📶' if kind == 'wifi' else '🌐') + connection.replace('\t', ' '))
    else:
        print('🌐×')
elif name == 'bluetooth':
    info = run('bluetoothctl', 'show')
    if not info or 'Powered: yes' not in info:
        print('🔵×')
    else:
        devices = [line for line in run('bluetoothctl', 'devices', 'Connected').splitlines() if line.startswith('Device ')]
        print('🔵' + (str(len(devices)) if devices else '✓'))
elif name == 'volume':
    info = run(str(Path.home()/'.local/bin/i3-audio'), 'status')
    if not info: print('🔊–')
    elif 'MUTED' in info: print('🔇')
    else:
        volume = float(info.split()[1])*100
        icon = '🔈' if volume < 1 else '🔉' if volume <= 50 else '🔊'
        print(f'{icon}{volume:.0f}%')
elif name == 'brightness':
    active_internal = False
    current_external = False
    external_levels = []
    for line in run('xrandr', '--current', '--verbose').splitlines():
        screen = re.match(r'^(\S+) connected\b(.*)', line)
        if screen:
            device, details = screen.groups()
            active = bool(re.search(r'\d+x\d+\+[-\d]+\+[-\d]+', details))
            internal = device.startswith(('eDP', 'LVDS', 'DSI'))
            active_internal = active_internal or (active and internal)
            current_external = active and not internal
        elif line and not line.startswith((' ', '\t')):
            current_external = False
        elif current_external and line.strip().startswith('Brightness:'):
            external_levels.append(float(line.split(':', 1)[1])*100)
    if not active_internal and external_levels:
        print(f'☀{sum(external_levels)/len(external_levels):.0f}%')
    else:
        info = run('brightnessctl', '-c', 'backlight', '-m')
        print('☀' + (info.split(',')[3] if info else '–'))
elif name == 'memory':
    mem = dict(line.split(':', 1) for line in read('/proc/meminfo').splitlines())
    total = int(mem['MemTotal'].split()[0]); available = int(mem['MemAvailable'].split()[0])
    used = (total-available)/total*100
    print(f'🧠{meter(used)}')
elif name == 'disk':
    s = os.statvfs(str(Path.home()))
    used = (s.f_blocks-s.f_bfree)/s.f_blocks*100
    print(f'💾{meter(used)}')
elif name in ('cpu', 'bandwidth'):
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home()/'.local/state')))/'i3config'
    state.mkdir(parents=True, exist_ok=True)
    cache = state/(name + '.json')
    try:
        old = json.loads(read(cache))
    except (ValueError, TypeError):
        old = {}
    now = time.monotonic()
    if name == 'cpu':
        values = list(map(int, read('/proc/stat').splitlines()[0].split()[1:9]))
        total, idle = sum(values), values[3] + values[4]
        delta = total - old.get('total', total)
        busy = 100 * (1 - (idle-old.get('idle', idle))/delta) if delta > 0 else 0
        print(f'⚙{meter(busy)}')
        data = {'total': total, 'idle': idle}
    else:
        routes = [line.split() for line in read('/proc/net/route').splitlines()[1:]]
        interfaces = [line[0] for line in routes if line[1] == '00000000']
        if not interfaces:
            print('↓0↑0'); data = {}
        else:
            interface = interfaces[0]
            rx = int(read(f'/sys/class/net/{interface}/statistics/rx_bytes') or 0)
            tx = int(read(f'/sys/class/net/{interface}/statistics/tx_bytes') or 0)
            elapsed = now - old.get('time', now)
            valid = elapsed > 0 and old.get('interface') == interface
            down = max(0, rx-old.get('rx', rx))/elapsed/1024 if valid else 0
            up = max(0, tx-old.get('tx', tx))/elapsed/1024 if valid else 0
            short = lambda value: f'{value/1024:.1f}M' if value >= 1024 else f'{value:.0f}K'
            print(f'↓{short(down)}↑{short(up)}')
            data = {'rx': rx, 'tx': tx, 'time': now, 'interface': interface}
    cache.write_text(json.dumps(data))
elif name == 'battery':
    batteries = [Path(p) for p in glob.glob('/sys/class/power_supply/*') if read(p+'/type') == 'Battery']
    labels = []
    for battery in batteries:
        capacity = read(battery/'capacity')
        status = read(battery/'status')
        icon = '🔌' if status in ('Charging', 'Full') else '🪫' if capacity.isdigit() and int(capacity) <= 20 else '🔋'
        labels.append(f'{icon}{capacity}%')
    print(' '.join(labels) or '🔌')
elif name == 'temperature':
    temps = []
    for p in glob.glob('/sys/class/thermal/thermal_zone*/temp'):
        value = read(p)
        if value.isdigit() and 0 < int(value) < 150000: temps.append(int(value)/1000)
    print(f'🌡{max(temps):.0f}°C' if temps else '🌡N/A')
