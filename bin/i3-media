#!/usr/bin/env python3
"""Keep Polybar metadata, playback state and controls on the same MPRIS player."""
import os
import signal
import subprocess
import sys


def player(*args):
    try:
        result = subprocess.run(['playerctl', *args], capture_output=True,
                                text=True, timeout=2)
        return result.stdout.strip() if result.returncode == 0 else ''
    except (OSError, subprocess.TimeoutExpired):
        return ''


def selected():
    rows = player('--all-players', '--format', '{{playerInstance}}\t{{status}}', 'status')
    choices = [line.split('\t', 1) for line in rows.splitlines() if '\t' in line]
    # A stopped browser must not steal controls from playing/paused music.
    choices.sort(key=lambda row: ({'Playing': 0, 'Paused': 1, 'Stopped': 2}.get(row[1], 3),
                                  not row[0].startswith('spotify'), row[0]))
    return choices[0] if choices else ('', '')


def render(mode):
    name, status = selected()
    if mode == 'icon':
        return '' if status == 'Playing' else ''
    title = player('--player', name, 'metadata', '--format', '{{artist}} — {{title}}') if name else ''
    title = title.strip(' —') or ('Audio ready' if name else 'Nothing playing')
    title = ' '.join(title.replace('%', '％').split())
    limit = max(8, min(80, int(os.environ.get('MEDIA_CHARS', '27'))))
    return title if len(title) <= limit else title[:limit-1] + '…'


def watch(mode):
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    # Connect the event source first so changes during the initial query are queued.
    command = 'status' if mode == 'icon' else 'metadata'
    fmt = '{{playerInstance}} {{status}}' + (' {{artist}} {{title}}' if mode == 'title' else '')
    stream = subprocess.Popen(['playerctl', '--all-players', '--follow', '--format', fmt, command],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    previous = None
    try:
        value = render(mode)
        print(value, flush=True)
        previous = value
        for _ in stream.stdout:
            value = render(mode)
            if value != previous:
                print(value, flush=True)
                previous = value
    except BrokenPipeError:
        pass
    finally:
        stream.terminate()
        try:
            stream.wait(timeout=2)
        except subprocess.TimeoutExpired:
            stream.kill()
            stream.wait()


def main():
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == 'watch' and args[1] in ('icon', 'title'):
        watch(args[1])
    elif len(args) == 1 and args[0] in ('play-pause', 'previous', 'next', 'stop'):
        name, _ = selected()
        if name:
            player('--player', name, args[0])
    else:
        print(render('icon' if args == ['icon'] else 'title'))


if __name__ == '__main__':
    main()
