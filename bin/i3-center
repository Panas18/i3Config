#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
if ! command -v eww >/dev/null 2>&1; then
  notify-send 'Control center' 'Eww is not installed yet.'
  exit 1
fi
# Keep the service tied to the current X11 login.
systemctl --user import-environment DISPLAY XAUTHORITY
systemctl --user start i3-eww.service
# Wait for the service socket before issuing window commands.
ready=false
for attempt in {1..30}; do
  if eww ping >/dev/null 2>&1; then ready=true; break; fi
  sleep 0.1
done
$ready || { notify-send 'Control center' 'Widget service did not start.'; exit 1; }
if [[ ${1:-} == launch ]]; then
  case ${2:-} in
    network) command='nm-connection-editor' ;;
    bluetooth) command='blueman-manager' ;;
    power) command="$HOME/.local/bin/i3-power-menu" ;;
    *) exit 2 ;;
  esac
  eww close control-center 2>/dev/null || true
  exec i3-msg "exec --no-startup-id $command"
fi
if [[ ${1:-} == close ]] || eww active-windows | grep -q '^control-center:'; then
  eww close control-center 2>/dev/null || true
else
  eww open control-center
  "$HOME/.local/bin/i3-center-watch" >/dev/null 2>&1 &
fi
