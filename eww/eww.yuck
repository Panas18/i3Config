(defwindow control-center
  :monitor "<primary>"
  :geometry (geometry :x "-12px" :y "58px" :width "340px" :height "236px" :anchor "top right")
  :stacking "fg" :windowtype "dialog" :wm-ignore false
  (box :class "panel" :orientation "v" :space-evenly false :spacing 12
    (box :space-evenly false
      (label :class "heading" :text "Quick settings" :hexpand true :xalign 0)
      (button :class "close" :timeout "10s" :onclick "~/.local/bin/i3-center close" "×"))
    (button :class "network" :timeout "10s" :onclick "~/.local/bin/i3-center launch network"
      (box :space-evenly false :spacing 16
        (label :class "icon" :text "")
        (label :text "Network" :hexpand true :xalign 0)
        (label :class "arrow" :text "›")))
    (button :class "bluetooth" :timeout "10s" :onclick "~/.local/bin/i3-center launch bluetooth"
      (box :space-evenly false :spacing 16
        (label :class "icon" :text "")
        (label :text "Bluetooth" :hexpand true :xalign 0)
        (label :class "arrow" :text "›")))
    (button :class "power" :timeout "10s" :onclick "~/.local/bin/i3-center launch power"
      (box :space-evenly false :spacing 16
        (label :class "icon" :text "")
        (label :text "Power" :hexpand true :xalign 0)
        (label :class "arrow" :text "›")))))
