command=~/.local/bin/i3-status
separator_block_width=8
markup=none

[temperature]
interval=10

[battery]
interval=15

[memory]
interval=5

[disk]
interval=30

[cpu]
interval=3

[bandwidth]
interval=2

[time]
command=date '+🕒 %a %d %b %H:%M'
interval=5
color=#a6e3a1

# Hidden normally; signal 10 shows a brief brightness readout after a keypress.
[brightness]
interval=once
signal=10
